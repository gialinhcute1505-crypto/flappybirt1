<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flappy Bird Class 8</title>
    <style>
        body { background-color: #222; color: white; font-family: sans-serif; text-align: center; margin: 0; padding: 20px; }
        .game-box { max-width: 400px; margin: 0 auto; padding: 15px; background: #333; border-radius: 10px; }
        .score-board { font-size: 20px; font-weight: bold; margin-bottom: 10px; color: #f1c40f; }
        canvas { background: #70c5ce; display: block; margin: 0 auto; border: 3px solid #fff; border-radius: 5px; }
        .tip { color: #aaa; font-size: 13px; margin-top: 10px; }
        #restartBtn { background: #27ae60; color: white; border: none; padding: 10px 20px; border-radius: 5px; font-size: 16px; cursor: pointer; margin-top: 10px; display: none; }
    </style>
</head>
<body>
    <div class="game-box">
        <div class="score-board">SCORE: <span id="score">0</span></div>
        <canvas id="canvas" width="320" height="480"></canvas>
        <div class="tip">Click on screen or press SPACE to jump</div>
        <button id="restartBtn" onclick="resetGame()">PLAY AGAIN</button>
    </div>

    <script>
        const canvas = document.getElementById("canvas");
        const ctx = canvas.getContext("2d");
        const scoreDisplay = document.getElementById("score");
        const restartBtn = document.getElementById("restartBtn");

        let bird = { x: 50, y: 150, w: 30, h: 22, gravity: 0.25, jump: 5.5, velocity: 0 };
        let pipes = [];
        let score = 0;
        let gameOver = false;
        let frame = 0;

        function start() {
            if (!gameOver) {
                bird.velocity += bird.gravity;
                bird.y += bird.velocity;

                if (bird.y + bird.h >= canvas.height || bird.y <= 0) gameOver = true;

                if (frame % 90 === 0) {
                    let gap = 120;
                    let topH = Math.floor(Math.random() * (canvas.height - gap - 100)) + 50;
                    pipes.push({ x: canvas.width, top: topH, bottom: canvas.height - topH - gap, passed: false });
                }
                frame++;

                pipes.forEach(p => {
                    p.x -= 2;
                    if (!p.passed && p.x + 50 < bird.x) {
                        score++;
                        p.passed = true;
                        scoreDisplay.innerText = score;
                    }
                    if (bird.x < p.x + 50 && bird.x + bird.w > p.x && (bird.y < p.top || bird.y + bird.h > canvas.height - p.bottom)) {
                        gameOver = true;
                    }
                });
                pipes = pipes.filter(p => p.x > -50);
            }
        }

        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            // Draw pipes
            ctx.fillStyle = "#73bf2e";
            pipes.forEach(p => {
                ctx.fillRect(p.x, 0, 50, p.top);
                ctx.fillRect(p.x, canvas.height - p.bottom, 50, p.bottom);
            });

            // Draw bird
            ctx.fillStyle = "#f39c12";
            ctx.fillRect(bird.x, bird.y, bird.w, bird.h);
            ctx.fillStyle = "#fff";
            ctx.fillRect(bird.x + bird.w - 10, bird.y + 3, 5, 5); 

            if (gameOver) {
                ctx.fillStyle = "rgba(0,0,0,0.5)";
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                ctx.fillStyle = "#e74c3c";
                ctx.font = "bold 30px sans-serif";
                ctx.fillText("GAME OVER", 65, canvas.height / 2);
                restartBtn.style.display = "inline-block";
            }
        }

        function loop() {
            start();
            draw();
            requestAnimationFrame(loop);
        }

        function jump() {
            if (!gameOver) bird.velocity = -bird.jump;
        }

        function resetGame() {
            bird = { x: 50, y: 150, w: 30, h: 22, gravity: 0.25, jump: 5.5, velocity: 0 };
            pipes = [];
            score = 0;
            gameOver = false;
            frame = 0;
            scoreDisplay.innerText = score;
            restartBtn.style.display = "none";
        }

        window.addEventListener("keydown", e => { if (e.code === "Space") jump(); });
        canvas.addEventListener("click", jump);
        loop();
    </script>
</body>
</html>
